NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute public HTTP(S) origin without a trailing slash. Required for Next.js builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Next.js server and Supabase Edge Functions use the same Paddle account and prices.
# Use PADDLE_API_KEY (not PADDLE_SANDBOX_API_KEY). Sandbox vs live is controlled by PADDLE_ENVIRONMENT.
# Never leave PADDLE_ENVIRONMENT unset — there is no silent default.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_ACCESS_SECRET=

# Paddle price IDs for the 3-tier pricing page (pri_… from Paddle dashboard / MCP).
# Edit marketing copy in lib/billing/tiers.ts; keep IDs here only.
PADDLE_PRICE_STARTER_MONTHLY_ID=
PADDLE_PRICE_STARTER_YEARLY_ID=
PADDLE_PRICE_PRO_MONTHLY_ID=
PADDLE_PRICE_PRO_YEARLY_ID=
PADDLE_PRICE_ADVANCED_MONTHLY_ID=
PADDLE_PRICE_ADVANCED_YEARLY_ID=

# Optional 14-day trial price variants (same amount/product as the regular price).
# First-time checkout uses these when set; otherwise it charges the regular price.
# Also used by server-side plan changes while a subscription is still trialing.
PADDLE_PRICE_STARTER_MONTHLY_TRIAL_ID=
PADDLE_PRICE_STARTER_YEARLY_TRIAL_ID=
PADDLE_PRICE_PRO_MONTHLY_TRIAL_ID=
PADDLE_PRICE_PRO_YEARLY_TRIAL_ID=

# Browser configuration. Paddle.js accepts only a client-side token (never the API key).
# Sandbox tokens start with test_ ; live tokens start with live_.
# Create via Paddle dashboard (Developer tools → Authentication) or paddle-sandbox MCP.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT must be "sandbox" or "live" (required, no default).
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Default payment link page on your domain (not localhost):
#   ${NEXT_PUBLIC_SITE_URL}/checkout
# Set under Paddle Checkout → Checkout settings (or MCP PATCH /settings/checkout-url).

# Supabase Edge Functions only.
PADDLE_WEBHOOK_SECRET=
PADDLE_INGRESS_TOKEN=
# Public app origin used by Edge checkout (no trailing slash). Must match the running app.
SITE_URL=http://localhost:3000
