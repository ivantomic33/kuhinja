{
  "name": "treuplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib middleware.ts next.config.ts vitest.config.ts scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "fonts:og": "node scripts/fetch-og-fonts.mjs",
    "check:pwa-icons": "node scripts/check-pwa-icon-versions.mjs",
    "pkg:install": "pnpm install",
    "pkg:audit": "pnpm audit --audit-level high",
    "pkg:frozen": "pnpm install --frozen-lockfile",
    "perf:bench": "vitest run lib/perf/list-scale.bench.test.ts",
    "perf:seed": "node scripts/perf/seed.mjs",
    "perf:browser": "node scripts/perf/browser-harness.mjs",
    "perf:k6:recipes": "k6 run load/recipes-concurrent.js",
    "perf:k6:realtime": "k6 run load/realtime.js",
    "perf:k6:integrity": "k6 run load/concurrency-integrity.js"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.6",
    "@paddle/paddle-node-sdk": "^3.12.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^8.55.0",
    "@serwist/next": "^9.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.80.6",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.15.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.511.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.6.0",
    "zod": "^3.25.42",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18"
    }
  }
}
